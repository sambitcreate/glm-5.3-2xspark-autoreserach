# Run on the existing serving head. Replace with the actual worker SSH destination.
WORKER_SSH=your-user@your-worker
HEAD_CONTAINER=glm53-exl3-head
WORKER_CONTAINER=glm53-exl3-worker
PROBE_CONTAINER=glm53-kernel-feasibility
